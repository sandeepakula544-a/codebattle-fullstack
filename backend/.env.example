# Server Port (default 8080 or assigned by cloud platform like Railway/Render)
PORT=8080

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/codebattle?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# CORS Configuration (comma-separated list of allowed frontend domains or *)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration (Secret must be at least 32 characters)
JWT_SECRET=super-secret-jwt-key-for-codebattle-arena-production-at-least-32chars
JWT_EXPIRATION_MS=604800000

# Hibernate mode (update or validate)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
