# Base REST API URL (pointing to backend /api)
# In development:
VITE_API_URL=http://localhost:8080/api

# Base WebSocket URL (pointing to backend /ws endpoint)
# In development:
VITE_WS_URL=http://localhost:8080/ws

# For production (e.g. deployed on Render/Railway/VPS):
# VITE_API_URL=https://your-backend-domain.com/api
# VITE_WS_URL=https://your-backend-domain.com/ws
